{
  "name": "dsh-cost-receipt",
  "version": "0.1.0",
  "type": "module",
  "description": "DeepSeek Harness plugin: one line under every reply showing what that exchange cost, plus the account and bonus balances. Peak/off-peak CNY pricing from real token usage. No network calls of its own, no storage.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/divineeagleblackhand/dsh-cost-receipt.git"
  },
  "homepage": "https://github.com/divineeagleblackhand/dsh-cost-receipt#readme",
  "bugs": {
    "url": "https://github.com/divineeagleblackhand/dsh-cost-receipt/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cost",
    "billing",
    "balance",
    "receipt",
    "cny"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json"
  ],
  "scripts": {
    "test": "node test/verify-pricing.mjs",
    "prepublishOnly": "node test/verify-pricing.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-api-account-controller",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
